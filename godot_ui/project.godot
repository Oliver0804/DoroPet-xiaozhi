; 小智 Godot 介面
; Godot 4.4+ / gd_cubism（與 DoroPet 同一套 Live2D）

config_version=5

[application]

config/name="小智"
config/description="小智 AI 桌面介面"
config/version="2.1.2"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[autoload]

Bridge="*res://scripts/bridge.gd"

[display]

window/size/viewport_width=400
window/size/viewport_height=460
window/size/window_width_override=400
window/size/window_height_override=460
window/size/transparent=true
window/size/borderless=true
window/size/always_on_top=true
window/per_pixel_transparency/allowed=true
window/subwindows/embed_subwindows=false
window/stretch/mode="disabled"
window/stretch/aspect="ignore"

[rendering]

renderer/rendering_method="gl_compatibility"
viewport/transparent_background=true
textures/canvas_textures/default_texture_filter=3
environment/defaults/default_clear_color=Color(0, 0, 0, 0)
