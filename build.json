{
  "entry": "main.py",
  "name": "DoroPet",
  "display_name": "DoroPet",
  "version": "2.1.2",
  "icon": "assets/icon.png",
  "pyinstaller": {
    "onefile": false,
    "windowed": true,
    "add_data": [
      "models:models",
      "scripts:scripts",
      "src:src",
      "libs:libs",
      "assets:assets",
      "godot_ui:godot_ui",
      "discord_bridge:discord_bridge",
      "vendor/godot:vendor/godot"
    ],
    "clean": true,
    "noconfirm": true
  },
  "platforms": {
    "macos": {
      "bundle_identifier": "com.doropet.xiaozhi",
      "minimum_system_version": "11.0",
      "category": "public.app-category.productivity",
      "microphone_usage_description": "DoroPet 需要使用麥克風，才能跟你說話。",
      "speech_recognition_usage_description": "DoroPet 需要語音辨識，才能聽懂你說的話。",
      "camera_usage_description": "DoroPet 需要使用相機。",
      "copyright": "© 2026 Oliver. All rights reserved.",
      "dmg": {
        "volname": "DoroPet",
        "window_size": [
          600,
          450
        ],
        "icon_size": 100,
        "format": "UDZO"
      }
    },
    "windows": {
      "inno_setup": {
        "create_desktop_icon": true,
        "create_start_menu_icon": true,
        "allow_run_after_install": true,
        "languages": [
          "chinesetraditional",
          "english"
        ]
      },
      "pyinstaller": {
        "contents_directory": "."
      }
    },
    "linux": {
      "deb": {
        "package": "py-xiaozhi",
        "section": "utils",
        "priority": "optional",
        "desktop_entry": true,
        "categories": [
          "Utility"
        ]
      }
    }
  }
}
